{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@chobitsu/*": ["../packages/chobitsu/src/*"],
      "rwd:locale-loader": ["./src/localeLoader.ts"],
      "licia/*": ["./node_modules/licia/*"],
      "modern-screenshot": ["./node_modules/modern-screenshot"],
      "devtools-protocol": ["./node_modules/devtools-protocol"],
      "axios": ["./node_modules/axios"]
    }
  },
  "include": ["src/**/*.ts"]
}
