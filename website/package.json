    "gsap": "3.15.0",
    "lottie-web": "5.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "astro": "7.4.5",
    "qrcode-generator": "2.0.4",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
