{
  "name": "@rwd/website",
  "version": "0.1.0",
  "private": true,
  "description": "debugger.site: the Remote WebView Debugger website with an in-browser demo that runs the real page SDK",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
