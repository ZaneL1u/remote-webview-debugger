---
import type { Dict } from '../i18n/en.ts'
import SectionHead from './SectionHead.astro'

interface Props {
  t: Dict
}
const { t } = Astro.props
const f = t.faq
---

<section id="faq" class="section section-alt" aria-labelledby="faq-title">
  <div class="wrap">
    <SectionHead num="08" kicker={f.kicker} title={f.title} id="faq-title" />
    <div class="faq">
      {f.items.map(it => (
        <details class="qa reveal hud">
          <summary><span>{it.q}</span><span class="qa-ic" aria-hidden="true"></span></summary>
          <div class="qa-a"><p set:html={it.a} /></div>
        </details>
      ))}
    </div>
  </div>
</section>
