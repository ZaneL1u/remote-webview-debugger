---
import type { Dict } from '../i18n/en.ts'
import { REPO, SDK_CDN } from '../lib/site.ts'
import { copyButton } from '../lib/html.ts'
import Icon from './Icon.astro'

interface Props {
  t: Dict
}
const { t } = Astro.props
const h = t.hero
const f = h.flow
const q = h.quick
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-inner">
      <p class="eyebrow reveal" data-hero="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>{h.eyebrow}</p>
      <h1 id="hero-title" class="reveal" data-hero="title" set:html={h.titleHtml} />
      <p class="hero-sub reveal" data-hero="sub">{h.sub}</p>
      <div class="cta reveal" data-hero="cta">
        <a class="btn btn-primary" href="#demo"><Icon name="play" /><span>{h.ctaDemo}</span></a>
        <a class="btn btn-ghost" href="#live"><Icon name="key" /><span>{h.ctaLive}</span></a>
        <a class="btn btn-ghost btn-icon" href={REPO} aria-label={h.ctaGithub} title={h.ctaGithub}><Icon name="github" /><span class="btn-icon-text">{h.ctaGithub}</span></a>
      </div>
      <div class="quick code reveal" data-hero="install" data-tabs>
        <div class="quick-head">
          <div class="quick-tabs" role="tablist" aria-label={q.label}>
            <button role="tab" type="button" id="quick-tab-agent" aria-controls="quick-agent" aria-selected="true" tabindex="0"><Icon name="bot" />{q.agent}</button>
            <button role="tab" type="button" id="quick-tab-script" aria-controls="quick-script" aria-selected="false" tabindex="-1"><Icon name="terminal" />{q.script}</button>
          </div>
          <Fragment set:html={copyButton()} />
        </div>
        <div class="quick-body" role="tabpanel" id="quick-agent" aria-labelledby="quick-tab-agent">
          <pre dir="auto"><span class="quick-caret" aria-hidden="true">❯</span><code>{q.prompt}</code></pre>
          <p class="quick-hint" dir="auto">{q.agentHint}</p>
        </div>
        <div class="quick-body" role="tabpanel" id="quick-script" aria-labelledby="quick-tab-script" hidden>
          <pre><code><span class="t-t">&lt;script</span> <span class="t-a">src</span>=<span class="t-s">"{SDK_CDN}"</span><span class="t-t">&gt;&lt;/script&gt;</span>
<span class="t-t">&lt;script&gt;</span>RemoteWebviewDebugger.<span class="t-fn">run</span>(<span class="t-s">"https://&lt;gateway&gt;/v1"</span>, <span class="t-s">"rwd_pk_…"</span>)<span class="t-t">&lt;/script&gt;</span></code></pre>
        </div>
      </div>
    </div>
    <div class="flow reveal hud" role="img" aria-label={f.label} data-flow>
      <div class="flow-node flow-agent hud" data-flow-node><span class="flow-ic"><Icon name="bot" /></span><div><b>{f.agent}</b><small>{f.agentSub}</small></div></div>
      <div class="flow-link"><span class="flow-wire" data-wire><i></i><i></i></span><span class="flow-label">{f.mcp}</span></div>
      <div class="flow-node flow-gw hud" data-flow-node><span class="flow-ic"><Icon name="server" /></span><div><b>{f.gw}</b><small>{f.gwSub}</small></div></div>
      <div class="flow-link"><span class="flow-wire" data-wire><i></i><i></i></span><span class="flow-label">{f.ws}</span></div>
      <div class="flow-node flow-phone hud" data-flow-node>
        <span class="flow-ic"><span class="flow-pulse" data-lottie="pulse" aria-hidden="true"></span><Icon name="phone" /></span>
        <div><b>{f.phone}</b><small>{f.phoneSub}</small></div>
        <span class="flow-state"><span></span>{f.state}</span><code class="flow-code">K7Q2-9M4X</code>
      </div>
    </div>
  </div>
</section>
