---
import { DEFAULT, LOCALES } from '../../i18n/locales.ts'
import Page from '../../components/Page.astro'

export function getStaticPaths() {
  return LOCALES.filter(l => l !== DEFAULT).map(l => ({ params: { lang: l.path }, props: { locale: l } }))
}
const { locale } = Astro.props
---

<Page locale={locale} />
