{
	admin off
}

# Public host: Caddy terminates TLS itself (Let's Encrypt / ZeroSSL) for
# RWD_DOMAIN and redirects :80 to HTTPS. Used through compose.tls.yml.
{$RWD_DOMAIN} {
	redir /demo /demo/

	handle_path /demo/* {
		root * /srv/demo
		header Cache-Control "no-cache"
		file_server
	}

	# Gateway: /v1/* (SDK, page WS, REST, MCP) and the console SPA.
	handle {
		reverse_proxy gateway:8080
	}
}
